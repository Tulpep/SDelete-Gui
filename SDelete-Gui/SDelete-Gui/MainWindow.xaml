<controls:MetroWindow x:Class="SDelete_Gui.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      Title="SDelete Gui" Height="420" Width="400"
                      ResizeMode="NoResize"
                      WindowTransitionsEnabled="True"
                      DataContext="{Binding Main, Source={StaticResource Locator}}" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="38"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="36"/>
        </Grid.ColumnDefinitions>

        <Button Style="{DynamicResource MahApps.Styles.Button.Circle}" Command="{Binding InfoCommand}"
                Grid.Row="0" Grid.Column="2" ToolTip="{Binding InfoToolTip, Source={StaticResource ResourceKey=Messages}}"
                VerticalAlignment="Center" HorizontalAlignment="Right" Height="24" Width="24">
            <Path Stretch="Fill" Fill="#FF3F3F46"
                  Data="F1 M 38,19C 48.4934,19 57,27.5066 57,38C 57,48.4934 48.4934,57 38,57C 27.5066,57 19,48.4934 19,38C 19,27.5066 27.5066,19 38,19 Z M 33.25,33.25L 33.25,36.4167L 36.4166,36.4167L 36.4166,47.5L 33.25,47.5L 33.25,50.6667L 44.3333,50.6667L 44.3333,47.5L 41.1666,47.5L 41.1666,36.4167L 41.1666,33.25L 33.25,33.25 Z M 38.7917,25.3333C 37.48,25.3333 36.4167,26.3967 36.4167,27.7083C 36.4167,29.02 37.48,30.0833 38.7917,30.0833C 40.1033,30.0833 41.1667,29.02 41.1667,27.7083C 41.1667,26.3967 40.1033,25.3333 38.7917,25.3333 Z "
                  Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Button>

        <Label x:Name="PasessLabel" Content="{Binding HowManyPasses, Source={StaticResource ResourceKey=Messages}}"
               Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <controls:NumericUpDown Minimum="1" Maximum="100" Value="{Binding NumberOfPasses}"
                                Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="28" VerticalAlignment="Center"/>

        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center"
                  IsChecked="{Binding ConfirmBeforeDelete}"
                  Content="{Binding ConfirmBeforeDeleteLabel, Source={StaticResource ResourceKey=Messages}}"/>

        <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center"
                  IsChecked="{Binding SequentialExecution}"
                  Content="{Binding SequentialExecutionLabel, Source={StaticResource ResourceKey=Messages}}"/>

        <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center"
                  IsChecked="{Binding UsePassSubmenu}"
                  Content="{Binding UsePassSubmenuLabel, Source={StaticResource ResourceKey=Messages}}"/>

        <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center"
                  IsChecked="{Binding ShowContextMenuIcon}"
                  Content="{Binding ShowContextMenuIconLabel, Source={StaticResource ResourceKey=Messages}}"/>

        <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center"
                  IsChecked="{Binding EnableAuditLog}"
                  Content="{Binding EnableAuditLogLabel, Source={StaticResource ResourceKey=Messages}}"/>

        <Label Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Padding="0" VerticalAlignment="Bottom"
               Content="{Binding LogFilePathLabel, Source={StaticResource ResourceKey=Messages}}"/>
        <TextBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" Height="26"
                 IsEnabled="{Binding EnableAuditLog}"
                 Text="{Binding LogFilePath, UpdateSourceTrigger=PropertyChanged}"/>

        <Grid Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Command="{Binding ConfigureCommand}"
                    Content="{Binding Enable, Source={StaticResource ResourceKey=Messages}}" Height="28"/>
            <Button Grid.Column="2" Command="{Binding UnConfigureCommand}"
                    Content="{Binding Disable, Source={StaticResource ResourceKey=Messages}}" Height="28"/>
        </Grid>

        <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Top" Margin="0,8,0,0"
                   TextWrapping="Wrap" Grid.ColumnSpan="3" Grid.Row="10"/>
    </Grid>
</controls:MetroWindow>
